    "(?i)\\b(sales|account executive|seller|recruiter|recruiting|sourcer|marketing|counsel|legal|paralegal|accountant|controller|payroll|people ops|workplace|facilities|executive assistant)\\b",
    "(?i)\\b(hardware|mechanical|electrical|firmware|technician|manufacturing|optical|robotics technician|vehicle operator|driver)\\b",
    "(?i)\\b(designer|ux researcher|content strategist|copywriter|technical writer)\\b",
    "(?i)\\b(support|success|sales engineer|implementation|onboarding specialist)\\b",
    "(?i)\\b(gtm|go-to-market|strategic finance|transformation owner|partner engineer)\\b",
    "(?i)\\b(adoption lead|transformation lead|deployment lead|ai strategist|enablement|ecosystem architect|growth marketer|rvp|regional vice president|deal desk|post-doctoral|postdoctoral)\\b"
  ],
  "location_include": [
    "(?i)remote",
    "(?i)\\b(YOUR_CITY|YOUR_SUBURB|YOUR_AIRPORT_CODE)\\b",
    "(?i)YOUR_STATE|,\\s*XX\\b",
